# Testing Environment Configuration
ENVIRONMENT=testing
DEBUG=true

# API Configuration
API_HOST=127.0.0.1
API_PORT=8001
API_WORKERS=1

# Authentication (test keys)
API_KEYS=test-api-key-12345,test-api-key-67890

# Logging
LOG_LEVEL=WARNING
LOG_FILE=logs/app-test.log

# CORS (permissive for testing)
CORS_ORIGINS=*

# ML Models (use smaller/faster models for testing)
MODELS_BASE_PATH=tests/fixtures/models
CONFIDENCE_THRESHOLD=0.5
MAX_AUDIO_DURATION=60  # Shorter for tests
MIN_AUDIO_DURATION=0.1

# Security (relaxed for testing)
SSL_ENABLED=false
SECURITY_HEADERS_ENABLED=false
MAX_REQUEST_SIZE=10485760  # 10MB for tests
REQUEST_TIMEOUT=30

# Feature extraction (faster settings for tests)
SAMPLE_RATE=16000
N_MFCC=13
HOP_LENGTH=256
N_FFT=1024