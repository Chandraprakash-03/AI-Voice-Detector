# Production Environment Configuration
ENVIRONMENT=production
DEBUG=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Authentication (use strong API keys in production)
API_KEYS=RW-EIc3MNdYaLF8kP6ZVFWYkCMhLLrFQMVxkU5aCoLIirfDNoH1UUDLvK11AeMpCvDC,RW-oBcrCtawo3Jkkb01kGoe3qMzz3HKIMw65UEYh6dZR63b5ObH8sSCJykNrfV4gz7k

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app-prod.log

# CORS (restrictive for production)
CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# ML Models
MODELS_BASE_PATH=/app/models
CONFIDENCE_THRESHOLD=0.5
MAX_AUDIO_DURATION=300
MIN_AUDIO_DURATION=0.5

# # Security (strict for production)
# SSL_ENABLED=true
# SSL_CERT_FILE=/app/certs/cert.pem
# SSL_KEY_FILE=/app/certs/key.pem
# SECURITY_HEADERS_ENABLED=true
# MAX_REQUEST_SIZE=52428800  # 50MB
# REQUEST_TIMEOUT=300

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Feature extraction
SAMPLE_RATE=22050
N_MFCC=13
HOP_LENGTH=512
N_FFT=2048

